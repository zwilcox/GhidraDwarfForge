#!/usr/bin/env bash
set -euo pipefail
usage() {
    cat <<'HELP'
Usage: ghidra-dwarf-forge-report --report=<json> [--summary | --function=0xENTRY | --before=<json>]
       [--ghidra-dir=<installation>] [--extension-dir=<installed-extension>] [--java=<executable>]
Read-only reported evidence; no referenced ELF/source files are opened.
Default output is a summary and per-function TSV rows. Comparisons disclose identity limitations.
Exit: 0 displayed, 1 report/output error, 2 incomparable, 11 cancelled, 64 usage.
HELP
}
fail() { echo "ghidra-dwarf-forge-report: $1" >&2; exit 64; }
ghidra_dir=${GHIDRA_INSTALL_DIR:-}
extension_dir=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
java_path=
arguments=()
declare -A seen=()
for argument in "$@"; do
    key=${argument%%=*}
    [[ -z ${seen[$key]:-} ]] || fail "duplicate option: $key"
    seen[$key]=1
    case "$argument" in
        --help) usage; exit 0 ;;
        --ghidra-dir=*) ghidra_dir=${argument#*=} ;;
        --extension-dir=*) extension_dir=${argument#*=} ;;
        --java=*) java_path=${argument#*=} ;;
        --report=*|--before=*|--function=*) arguments+=("$key" "${argument#*=}") ;;
        --summary) arguments+=(--summary) ;;
        *) fail "unknown option: $key" ;;
    esac
done
[[ -n $ghidra_dir ]] || fail 'select --ghidra-dir or GHIDRA_INSTALL_DIR'
[[ -n ${seen[--report]:-} ]] || fail '--report is required'
ghidra_dir=$(realpath -e -- "$ghidra_dir") || fail 'Ghidra installation is missing'
extension_dir=$(realpath -e -- "$extension_dir") || fail 'extension directory is missing'
if [[ -z $java_path ]]; then
    if [[ -n ${JAVA_HOME:-} ]]; then java_path="$JAVA_HOME/bin/java"
    else java_path=$(command -v java) || fail 'Java 21 or later is required'; fi
fi
java_path=$(realpath -e -- "$java_path") || fail 'Java executable is missing'
[[ -x $java_path ]] || fail 'Java selection is not executable'
classpath=
for dependency in "$extension_dir/lib/GhidraDwarfForge.jar" \
        "$ghidra_dir/Ghidra/Framework/Pty/lib/jna-5.14.0.jar" \
        "$ghidra_dir/Ghidra/Framework/Generic/lib/gson-2.9.0.jar"; do
    [[ -f $dependency ]] || fail "installed dependency is missing: $dependency"
    [[ $dependency != *:* ]] || fail 'classpath installation paths cannot contain a colon'
    classpath+="${classpath:+:}$dependency"
done
exec "$java_path" -cp "$classpath" ghidradwarfforge.output.CoverageReportTool "${arguments[@]}"
