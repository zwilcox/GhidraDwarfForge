+/*  GNU/Linux and Solaris PN_XNUM stores an extended program-header
+    count in section zero's sh_info. This reader does not consume program
+    headers, but must validate the claimed table before accepting this use
+    of sh_info. Ordinary ELF section-zero rules remain unchanged. */
+static int
+valid_section_zero_program_count(dwarf_elf_object_access_internals_t *ep,
+    struct generic_shdr *section_zero,
+    Dwarf_Unsigned header_size,
+    Dwarf_Unsigned program_entry_size)
+{
+    struct generic_ehdr *ehdr = ep->f_ehdr;
+    const Dwarf_Unsigned pn_xnum = 0xffff;
+
+    if (ehdr->ge_phnum != pn_xnum) {
+        return section_zero->gh_info == 0;
+    }
+    if (section_zero->gh_info < pn_xnum ||
+        ehdr->ge_ehsize < header_size ||
+        ehdr->ge_phoff < ehdr->ge_ehsize ||
+        ehdr->ge_phoff > ep->f_filesize ||
+        ehdr->ge_phentsize < program_entry_size) {
+        return FALSE;
+    }
+    /*  Subtraction and division avoid overflow in offset + count * size.
+        No allocation or scan is proportional to the extended count. */
+    return section_zero->gh_info <=
+        (ep->f_filesize - ehdr->ge_phoff) / ehdr->ge_phentsize;
+}
