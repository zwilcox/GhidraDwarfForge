#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ghidra-dwarf-forge-attach --request=<absolute-json> --request-sha256=<sha256>
       --ghidra-dir=<installation> [--extension-dir=<installed-extension>]
       [--java=<java-executable>] [--recover] [--preview] [--cancel-file=<absolute-empty-file>]
       [--confirm-target-change] [--authorize=sudo|pkexec]

Attachment changes the selected executable and retains an independent backup.
Recovery restores the selected pre-operation image. Both require explicit
--confirm-target-change. The selected files are shown before any authorization.
--preview only validates and displays selections; it never starts a native host.
--authorize explicitly requests OS authorization for the separate helper.
Without it, the helper uses the current authorization and never retries elevation.
Ghidra itself is never elevated. Preserve all selected backups and receipts.
EOF
}

fail() { echo "ghidra-dwarf-forge-attach: $1" >&2; exit 64; }

ghidra_dir=${GHIDRA_INSTALL_DIR:-}
extension_dir=
java_path=
request=
request_sha=
cancel_file=
authorize=
confirm=0
preview=0
recover=0
declare -A seen=()
for argument in "$@"; do
    key=${argument%%=*}
    [[ -z ${seen[$key]:-} ]] || fail "duplicate option: $key"
    seen[$key]=1
    case "$argument" in
        --help) usage; exit 0 ;;
        --ghidra-dir=*) ghidra_dir=${argument#*=} ;;
        --extension-dir=*) extension_dir=${argument#*=} ;;
        --java=*) java_path=${argument#*=} ;;
        --request=*) request=${argument#*=} ;;
        --request-sha256=*) request_sha=${argument#*=} ;;
        --cancel-file=*) cancel_file=${argument#*=} ;;
        --authorize=sudo|--authorize=pkexec) authorize=${argument#*=} ;;
        --confirm-target-change) confirm=1 ;;
        --preview) preview=1 ;;
        --recover) recover=1 ;;
        *) fail "unknown option: $key" ;;
    esac
done
[[ $request == /* && $request_sha =~ ^[0-9a-f]{64}$ ]] ||
    fail 'select an absolute --request and its lowercase --request-sha256'
[[ -n $ghidra_dir ]] || fail '--ghidra-dir or GHIDRA_INSTALL_DIR is required'
ghidra_dir=$(realpath -e -- "$ghidra_dir") || fail 'Ghidra installation is missing'
if [[ -z $extension_dir ]]; then
    extension_dir=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
else
    extension_dir=$(realpath -e -- "$extension_dir") || fail 'extension directory is missing'
fi
if [[ -z $java_path ]]; then
    if [[ -n ${JAVA_HOME:-} ]]; then
        java_path="$JAVA_HOME/bin/java"
    else
        java_path=$(command -v java) || fail 'Java 21 or later is required'
    fi
fi
java_path=$(realpath -e -- "$java_path") || fail 'Java executable is missing'
[[ -x $java_path ]] || fail 'Java selection is not executable'
jar="$extension_dir/lib/GhidraDwarfForge.jar"
jna="$ghidra_dir/Ghidra/Framework/Pty/lib/jna-5.14.0.jar"
gson="$ghidra_dir/Ghidra/Framework/Generic/lib/gson-2.9.0.jar"
for dependency in "$jar" "$jna" "$gson"; do
    [[ -f $dependency ]] || fail "required installed dependency is missing: $dependency"
    [[ $dependency != *:* ]] || fail 'Java classpath installation paths cannot contain a colon'
done
command=("$java_path" --enable-native-access=ALL-UNNAMED -cp "$jar:$jna:$gson"
    ghidradwarfforge.output.AttachmentHelper --request "$request" --request-sha256 "$request_sha")
if ((recover)); then command+=(--recover); fi
if [[ -n $cancel_file ]]; then
    [[ $cancel_file == /* ]] || fail '--cancel-file must be absolute'
    command+=(--cancel-file "$cancel_file")
fi

# Preview runs unprivileged and checks the same pinned request used below.
# It opens no log/output path and executes no selected validator.
"${command[@]}" --preview
if ((preview)); then exit 0; fi
((confirm)) || fail 'review the selection and pass --confirm-target-change to modify the target'
command+=(--confirm-target-change)
echo 'Starting explicit target change. Retain the selected recovery request, backups and receipts.' >&2
if [[ -n $authorize ]]; then
    authorization_program=$(command -v "$authorize") || fail "authorization program is unavailable: $authorize"
    authorization_program=$(realpath -e -- "$authorization_program")
    # Arrays preserve literal paths; no shell fragment is passed to the authorizer.
    if [[ $authorize == sudo ]]; then exec "$authorization_program" -- "${command[@]}"; fi
    exec "$authorization_program" "${command[@]}"
fi
exec "${command[@]}"
