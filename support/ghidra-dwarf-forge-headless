#!/usr/bin/env bash
set -uo pipefail

usage() {
    cat >&2 <<'EOF'
Usage:
  ghidra-dwarf-forge-headless --import=<elf> [options]
  ghidra-dwarf-forge-headless --project-dir=<dir> --project-name=<name> \
      --program=<project-path> [options]

Common options:
  --ghidra-dir=<dir>      Ghidra installation (or GHIDRA_INSTALL_DIR)
  --libdwarf=<path>       Override packaged libdwarf (requires --libdwarfp)
  --libdwarfp=<path>      Override packaged libdwarfp (requires --libdwarf)
  --input=<elf>           Original ELF override (defaults to --import value)
  --target-profile=cortex-m3  Require the bounded ARMv7-M Thumb/base-PCS profile
  --raw-firmware=cortex-m3   Export an existing saved raw-firmware program
  --firmware-inputs=<json>   Bind its FileBytes to original inputs (raw mode only)
  --output=<path>         Sidecar path (default: <input>.dbg)
  --source-lines=<n>      Optional source lines per file; whole functions stay together
                          Default: one synthetic source file
  --formatters=<json>    Explicit canonical-type selections for GDB/LLDB formatters
  --mmio                Export the explicitly saved MMIO snapshot profile
  --gdb-loader            Also generate <sidecar>.gdb.py for explicit GDB loading
  --compress-debug-sections=none|zlib
                          Optional ELF debug-section compression (default: none)
  --annotation-record-limit=<n>  Stored comment/equate/reference limit (default: 1000000)
  --annotation-text-limit=<n>    Stored UTF-16 text units (default: 16777216)
  --annotation-source-limit=<n>  Complete source UTF-8 bytes (default: 134217728)
  --source-context=off|assembly|pcode|both
                          Instruction context for incomplete source (default: off)
  --synthesize-unwind=off|strict|conditioned
                          Recover ordinary call frames (default: off)
  --unwind-stack-separation=<hex-first:hex-last,...>
                          Explicit condition: ranges never overlap live caller/group stack
  --unwind-relocated-pointers=off|fixed
                          Explicit invariant relocated-pointer condition (default: off)
  --log=<path>            Preserve the complete headless transcript
  --analysis-timeout=<s> Import-mode analysis timeout (default: 120)

ELF64 virtual addresses use the full unsigned address space. A function's
exclusive end address must fit in 64 bits.

Ordinary export replaces each public file atomically. A reader opening multiple
names during publication can see different generations. Wait for the terminal
report before opening the set. Updating an existing file uses a Linux atomic
exchange or Windows transactional rename on NTFS. On filesystems without an
exchange primitive, select unused output names. An interrupted process can leave an active claim
in a .ghidra-dwarf-forge-publishing-* file beside each output. It names
the process and generation.properties recovery inventory. Verify that process
has stopped before recovery. Preserve the listed stages and backups. Compare
the current files to the recorded old/new SHA-256 values or symlink targets,
then restore one complete generation. Treat any other content as an external
change. Retire the recorded claim only after checking every output.

Existing-project mode opens one saved program through a read-only project
handle. A basename selects a root file; /folder/program selects a nested file.
Analysis is disabled. The saved project and program are never deleted or saved.
In existing-project mode, --log requires --input and a new filename. The
wrapper captures the transcript privately and copies it without overwriting.
Raw mode requires existing-project mode and --input. Its memory map comes from
the saved program. With --firmware-inputs, omit --log: only a private transcript
is safe before Java validates every input path in that descriptor.

Exit codes:
  0   Export completed (SUCCESS or PARTIAL; inspect the JSON report)
  10  Export reported FATAL
  11  Export reported CANCELLED
  12  Ghidra failed or its report could not be read (requires Python 3)
  64  Invalid command-line usage
EOF
}

die_usage() {
    echo "ghidra-dwarf-forge-headless: $1" >&2
    usage
    exit 64
}

# Resolve existing symlink components even when the destination does not exist.
# The inode comparison also catches hard links whose canonical names differ.
reject_log_alias() {
    local protected=$1 canonical lexical candidate
    [[ -n "$protected" ]] || return 0
    lexical=$(realpath -m -s -- "$protected") ||
        die_usage "cannot resolve protected path: $protected"
    # Protect actual traversal and its lexical lookalike. Legacy clients can
    # interpret '..' differently; neither spelling may become a log target.
    for candidate in "$protected" "$lexical"; do
        canonical=$(realpath -m -- "$candidate") ||
            die_usage "cannot resolve protected path: $protected"
        if [[ "$canonical_log" == "$canonical" || "$log_path" -ef "$candidate" ]]; then
            die_usage "log path aliases a protected input/output file: $protected"
        fi
    done
}

reject_log_in_tree() {
    local protected=$1 canonical linked lexical candidate
    lexical=$(realpath -m -s -- "$protected") ||
        die_usage "cannot resolve protected directory: $protected"
    for candidate in "$protected" "$lexical"; do
        canonical=$(realpath -m -- "$candidate") ||
            die_usage "cannot resolve protected directory: $protected"
        if [[ "$canonical_log" == "$canonical" || "$canonical_log" == "$canonical/"* ]]; then
            die_usage "log path is inside a protected library/project directory: $protected"
        fi
        if [[ -f "$log_path" && -d "$candidate" ]]; then
            linked=$(find -L "$canonical" -type f -samefile "$log_path" -print -quit) ||
                die_usage "cannot check log aliases in protected directory: $protected"
            [[ -z "$linked" ]] || die_usage "log path aliases a protected file: $linked"
        fi
    done
}

source_bundle_name() {
    [[ "$1" =~ ^forge-src-([0-9]{6}-[0-9a-f]{64}\.c|[0-9a-f]{64}\.json)$ ]]
}

reject_log_source_bundle() {
    local directory=$1 lexical candidate canonical protected log_directory
    log_directory=${canonical_log%/*}; log_directory=${log_directory:-/}
    # NUL-delimited resolution retains directory names ending in a newline.
    IFS= read -r -d '' lexical < <(realpath -m -s -z -- "$directory") ||
        die_usage "cannot resolve source directory: $directory"
    for candidate in "$directory" "$lexical"; do
        IFS= read -r -d '' canonical < <(realpath -m -z -- "$candidate") ||
            die_usage "cannot resolve source directory: $directory"
        if [[ "$log_directory" == "$canonical" ]] && source_bundle_name "${canonical_log##*/}"; then
            die_usage "log path aliases the reserved source bundle namespace: $log_path"
        fi
        [[ ! -d "$canonical" || ( -r "$canonical" && -x "$canonical" ) ]] ||
            die_usage "cannot check log aliases in source directory: $directory"
        for protected in "$canonical"/forge-src-*; do
            source_bundle_name "${protected##*/}" || continue
            # Regular files need only an inode comparison. Avoid spawning path
            # resolvers for every part in a large source generation.
            if [[ "$log_path" -ef "$protected" ]]; then
                die_usage "log path aliases a protected source bundle file: $protected"
            fi
            [[ ! -L "$protected" ]] || reject_log_alias "$protected"
        done
    done
}

validate_log_path() {
    local selected_input selected_output script_directory protected formatter_hash formatter_directory
    if ((project_mode)) && [[ -z "$input" ]]; then
        die_usage "--log in existing-project mode requires --input so the original and default outputs can be protected; otherwise omit --log to use a private temporary log"
    fi
    IFS= read -r -d '' canonical_log < <(realpath -m -z -- "$log_path") ||
        die_usage "cannot resolve log path: $log_path"
    if [[ -e "$log_path" && ( ! -f "$log_path" || ! -w "$log_path" ) ]]; then
        die_usage "log path is not a writable regular file: $log_path"
    fi
    selected_input=${input:-$import_path}
    selected_output=$output
    if [[ -z "$selected_output" && -n "$selected_input" ]]; then
        selected_output="$selected_input.dbg"
    fi
    for protected in "$import_path" "$input" "$selected_output" \
            "$consumer" "$producer" "$formatter_selection" "$headless" "$0"; do
        reject_log_alias "$protected"
    done
    if [[ -n "$selected_output" ]]; then
        reject_log_alias "$selected_output.c"
        reject_log_alias "$selected_output.gdb.py"
        reject_log_alias "$selected_output.unwind.json"
        reject_log_alias "$selected_output.firmware.json"
        reject_log_alias "$selected_output.mmio.json"
        formatter_hash=$(printf '%s' "${selected_output##*/}" | sha256sum) || die_usage "cannot derive formatter filename"
        formatter_hash=${formatter_hash%% *}
        # Command substitution strips trailing newlines from directory names.
        # Preserve every byte so symlink/hard-link log aliases remain protected.
        case "$selected_output" in
            */*) formatter_directory=${selected_output%/*}; formatter_directory=${formatter_directory:-/} ;;
            *) formatter_directory=. ;;
        esac
        reject_log_alias "$formatter_directory/forge_formatters_$formatter_hash.py"
        reject_log_source_bundle "$formatter_directory"
    fi
    if ((project_mode)); then
        reject_log_alias "$project_dir/$project_name.gpr"
        reject_log_alias "$project_dir/$project_name.lock"
        reject_log_in_tree "$project_dir/$project_name.rep"
    fi
    script_directory=$(cd "$(dirname -- "$0")" && pwd -P) || exit 64
    reject_log_in_tree "$script_directory/../os"
    reject_log_in_tree "$script_directory/../lib"
    reject_log_in_tree "$ghidra_dir/Ghidra/Extensions/GhidraDwarfForge/os"
    reject_log_in_tree "$ghidra_dir/Ghidra/Extensions/GhidraDwarfForge/lib"
}

ghidra_dir=${GHIDRA_INSTALL_DIR:-}
consumer=
producer=
input=
output=
gdb_loader=0
mmio=0
formatter_selection=
debug_compression=none
source_context=off
source_lines=
target_profile=
raw_firmware=
firmware_inputs=
import_path=
project_dir=
project_name=
program=
log_path=
analysis_timeout=120
annotation_options=()
unwind_options=()

for argument in "$@"; do
    case "$argument" in
        --ghidra-dir=*) ghidra_dir=${argument#*=} ;;
        --libdwarf=*) consumer=${argument#*=} ;;
        --libdwarfp=*) producer=${argument#*=} ;;
        --input=*) input=${argument#*=} ;;
        --output=*) output=${argument#*=} ;;
        --gdb-loader) gdb_loader=1 ;;
        --mmio) mmio=1 ;;
        --formatters=*) formatter_selection=${argument#*=}; [[ -n "$formatter_selection" ]] || die_usage "--formatters requires a selection file" ;;
        --compress-debug-sections=*) debug_compression=${argument#*=} ;;
        --source-context=*) source_context=${argument#*=} ;;
        --source-lines=*)
            source_lines=${argument#*=}
            [[ "$source_lines" =~ ^[1-9][0-9]{0,9}$ ]] && ((source_lines <= 2147483647)) ||
                die_usage "--source-lines must be an integer from 1 to 2147483647"
            ;;
        --target-profile=*)
            target_profile=${argument#*=}
            [[ "$target_profile" == cortex-m3 ]] || die_usage "--target-profile must be cortex-m3"
            ;;
        --raw-firmware=*)
            raw_firmware=${argument#*=}
            [[ "$raw_firmware" == cortex-m3 ]] || die_usage "--raw-firmware must be cortex-m3"
            ;;
        --firmware-inputs=*)
            firmware_inputs=${argument#*=}
            [[ -n "$firmware_inputs" ]] || die_usage "--firmware-inputs requires a selection file"
            ;;
        --synthesize-unwind=*|--unwind-stack-separation=*|--unwind-relocated-pointers=*)
            unwind_options+=("$argument") ;;
        --annotation-record-limit=*|--annotation-text-limit=*|--annotation-source-limit=*)
            annotation_options+=("$argument") ;;
        --import=*) import_path=${argument#*=} ;;
        --project-dir=*) project_dir=${argument#*=} ;;
        --project-name=*) project_name=${argument#*=} ;;
        --program=*) program=${argument#*=} ;;
        --log=*) log_path=${argument#*=} ;;
        --analysis-timeout=*) analysis_timeout=${argument#*=} ;;
        --help|-h) usage; exit 0 ;;
        *) die_usage "unknown argument: $argument" ;;
    esac
done

[[ "$debug_compression" == none || "$debug_compression" == zlib ]] ||
    die_usage "--compress-debug-sections must be none or zlib"
case "$source_context" in
    off|assembly|pcode|both) ;;
    *) die_usage "--source-context must be off, assembly, pcode or both" ;;
esac
[[ -n "$ghidra_dir" ]] || die_usage "--ghidra-dir or GHIDRA_INSTALL_DIR is required"
if [[ -n "$consumer" && -z "$producer" || -z "$consumer" && -n "$producer" ]]; then
    die_usage "--libdwarf and --libdwarfp must be supplied together"
fi
[[ "$analysis_timeout" =~ ^[1-9][0-9]*$ ]] ||
    die_usage "--analysis-timeout must be a positive integer"

import_mode=0
project_mode=0
[[ -n "$import_path" ]] && import_mode=1
if [[ -n "$project_dir" || -n "$project_name" || -n "$program" ]]; then
    project_mode=1
fi
if ((import_mode + project_mode != 1)); then
    die_usage "select exactly one of --import or existing-project mode"
fi
if ((project_mode)); then
    [[ -n "$project_dir" && -n "$project_name" && -n "$program" ]] ||
        die_usage "existing-project mode requires --project-dir, --project-name, and --program"
    [[ "$project_name" != */* && "$project_name" != *\\* ]] ||
        die_usage "--project-name must not contain a path separator"
fi
if [[ -n "$raw_firmware" ]]; then
    ((project_mode)) && [[ -n "$input" ]] ||
        die_usage "--raw-firmware requires existing-project mode and --input"
    [[ "$program" == /* ]] || die_usage "raw --program must be an absolute project path"
    [[ -z "$target_profile" && -z "$formatter_selection" ]] && ((gdb_loader == 0)) ||
        die_usage "raw mode cannot combine --target-profile, --formatters or --gdb-loader"
    for option in "${unwind_options[@]}"; do
        [[ "$option" == --synthesize-unwind=off || "$option" == --unwind-relocated-pointers=off ]] ||
            die_usage "raw mode does not support unwind synthesis"
    done
elif [[ -n "$firmware_inputs" ]]; then
    die_usage "--firmware-inputs requires --raw-firmware"
fi
if [[ -n "$firmware_inputs" && -n "$log_path" ]]; then
    die_usage "--firmware-inputs requires a private temporary log; omit --log to protect every selected input"
fi

headless="$ghidra_dir/support/analyzeHeadless"
[[ -x "$headless" ]] || die_usage "Ghidra headless launcher is not executable: $headless"
if [[ -n "$consumer" ]]; then
    [[ -f "$consumer" ]] || die_usage "libdwarf does not exist: $consumer"
    [[ -f "$producer" ]] || die_usage "libdwarfp does not exist: $producer"
fi

command -v python3 >/dev/null || { echo "Python 3 is required to read the export report" >&2; exit 12; }

temporary_root=
temporary_log=0
requested_project_log=
temporary_base=${TMPDIR:-/tmp}
[[ -d "$temporary_base" ]] || die_usage "temporary directory does not exist: $temporary_base"
temporary_base=$(cd "$temporary_base" && pwd -P)
cleanup() {
    if [[ -n "$temporary_root" ]]; then
        case "$temporary_root" in
            "$temporary_base"/ghidra-dwarf-forge-headless-wrapper.*)
                rm -rf -- "$temporary_root"
                ;;
            *)
                echo "refusing to remove unexpected temporary path: $temporary_root" >&2
                ;;
        esac
    fi
    if ((temporary_log)) && [[ -n "$log_path" ]]; then
        rm -f -- "$log_path"
    fi
}
trap cleanup EXIT

if [[ -z "$log_path" ]]; then
    log_path=$(mktemp -t ghidra-dwarf-forge-headless-report.XXXXXXXX.log) || exit 12
    temporary_log=1
else
    log_parent=$(dirname -- "$log_path")
    [[ -d "$log_parent" && -w "$log_parent" ]] ||
        die_usage "log directory is not writable: $log_parent"
    validate_log_path
    if ((project_mode)); then
        if [[ -e "$log_path" || -L "$log_path" ]]; then
            die_usage "existing-project mode requires a new log file: $log_path"
        fi
        requested_project_log=$log_path
    fi
fi

if [[ -n "$consumer" ]]; then
    export_options=("--libdwarf=$consumer" "--libdwarfp=$producer")
else
    export_options=("--packaged-natives")
fi
[[ -n "$input" ]] && export_options+=("--input=$input")
[[ -n "$output" ]] && export_options+=("--output=$output")
((gdb_loader)) && export_options+=("--gdb-loader")
((mmio)) && export_options+=("--mmio")
[[ -n "$formatter_selection" ]] && export_options+=("--formatters=$formatter_selection")
[[ "$debug_compression" == zlib ]] && export_options+=("--compress-debug-sections=zlib")
[[ "$source_context" != off ]] && export_options+=("--source-context=$source_context")
[[ -n "$source_lines" ]] && export_options+=("--source-lines=$source_lines")
[[ -n "$target_profile" ]] && export_options+=("--target-profile=$target_profile")
[[ -n "$raw_firmware" ]] && export_options+=("--raw-firmware=$raw_firmware")
[[ -n "$firmware_inputs" ]] && export_options+=("--firmware-inputs=$firmware_inputs")
export_options+=("${annotation_options[@]}" "${unwind_options[@]}")

if ((import_mode)); then
    [[ -f "$import_path" ]] || die_usage "import ELF does not exist: $import_path"
    if [[ -z "$input" ]]; then
        export_options+=("--input=$import_path")
    fi
    temporary_root=$(mktemp -d \
        "$temporary_base/ghidra-dwarf-forge-headless-wrapper.XXXXXXXX") || exit 12
    headless_arguments=(
        "$temporary_root" GhidraDwarfForgeHeadless -deleteProject
        -import "$import_path" -loader ElfLoader -analysisTimeoutPerFile "$analysis_timeout"
        -postScript GhidraDwarfForge.java "${export_options[@]}"
    )
else
    [[ -d "$project_dir" ]] || die_usage "project directory does not exist: $project_dir"
    [[ "$program" == /* ]] || program="/$program"
    temporary_root=$(mktemp -d \
        "$temporary_base/ghidra-dwarf-forge-headless-wrapper.XXXXXXXX") || exit 12
    if [[ -n "$requested_project_log" ]]; then
        log_path="$temporary_root/transcript.log"
    fi
    headless_arguments=(
        "$temporary_root" GhidraDwarfForgeHeadless -deleteProject -noanalysis
        -postScript GhidraDwarfForgeReadOnly.java "$project_dir" "$project_name" "$program"
        "${export_options[@]}"
    )
fi

set +e
"$headless" "${headless_arguments[@]}" 2>&1 | tee -- "$log_path"
pipeline_status=("${PIPESTATUS[@]}")
set -e
headless_status=${pipeline_status[0]}
if ((pipeline_status[1] != 0)); then
    echo "ghidra-dwarf-forge-headless: could not write the transcript" >&2
    exit 12
fi

if [[ -n "$requested_project_log" ]]; then
    # The saved program may name a different original than the supplied --input.
    # Exclusive creation also protects a destination created while Ghidra ran.
    python3 - "$log_path" "$requested_project_log" <<'PYLOG' || exit 12
import shutil
import sys

try:
    with open(sys.argv[1], "rb") as source, open(sys.argv[2], "xb") as destination:
        shutil.copyfileobj(source, destination)
except OSError as error:
    sys.exit(f"could not preserve the transcript: {error}")
PYLOG
fi

report_file="$temporary_root/export-report.json"
python3 - "$log_path" "$report_file" <<'PYTHON' || exit 12
import re
import sys

marker = re.compile(rb"^(?:INFO|ERROR)[ \t]+GhidraDwarfForge\.java>[ \t]+GhidraDwarfForge report: ")
try:
    found = False
    with open(sys.argv[1], "rb") as transcript:
        for line in transcript:
            message = marker.match(line)
            if not message:
                continue
            if found:
                raise ValueError("multiple export reports")
            found = True
            payload = line[message.end():].strip().removesuffix(b" (GhidraScript)")
            with open(sys.argv[2], "xb") as output:
                output.write(payload)
    if not found:
        raise ValueError("missing export report")
except (ValueError, OSError) as error:
    sys.exit("ghidra-dwarf-forge-headless: " + str(error))
PYTHON

support_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
extension_dir="$support_dir/.."
if [[ ! -f "$extension_dir/lib/GhidraDwarfForge.jar" ]]; then
    extension_dir="$ghidra_dir/Ghidra/Extensions/GhidraDwarfForge"
fi
report_status=0
"$support_dir/ghidra-dwarf-forge-report" --ghidra-dir="$ghidra_dir" --extension-dir="$extension_dir" \
    --report="$report_file" --terminal-status || report_status=$?
case "$report_status" in
    0)
        if ((headless_status != 0)); then
            echo "ghidra-dwarf-forge-headless: Ghidra exited $headless_status after a completed export" >&2
            exit 12
        fi
        exit 0 ;;
    10|11) exit "$report_status" ;;
    *) exit 12 ;;
esac
