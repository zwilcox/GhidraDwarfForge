#!/usr/bin/env bash
set -u

printf '%s\n' "$@" >"$FAKE_ARGUMENT_LOG"
if [[ -n "${FAKE_NEW_LOG:-}" ]]; then
    printf '%s\n' 'concurrent save' > "$FAKE_NEW_LOG"
fi
status=${FAKE_REPORT_STATUS:-SUCCESS}
fields='"artifacts":{"outputPath":"fixture.dbg"},"counts":{"functionsExported":1},"failure":null'
case "$status" in
    FATAL|CANCELLED) fields='"artifacts":null,"counts":null,"failure":{"type":"fixture","message":"fixture"}' ;;
esac
report='{"schemaVersion":1,"status":"'"$status"'",'"$fields"'}'
case "$status" in
    NONE) exit "${FAKE_HEADLESS_EXIT:-0}" ;;
    TRUNCATED) report='{"schemaVersion":2,"status":"SUCCESS","counts":' ;;
    INCOMPLETE) report='{"schemaVersion":2,"status":"SUCCESS"}' ;;
    TRAILING) report="$report unexpected" ;;
    MULTIPLE) report=${report/MULTIPLE/SUCCESS}; echo "INFO GhidraDwarfForge.java> GhidraDwarfForge report: $report" ;;
    PATH_MARKER) report=${report/PATH_MARKER/SUCCESS}; echo "INFO GhidraDwarfForge.java> input: /tmp/GhidraDwarfForge report: filename" ;;
    TRAILING_SUCCESS) report=${report/TRAILING_SUCCESS/SUCCESS}' unexpected' ;;
esac
echo "INFO  GhidraDwarfForge.java> GhidraDwarfForge report: $report (GhidraScript)"
exit "${FAKE_HEADLESS_EXIT:-0}"
